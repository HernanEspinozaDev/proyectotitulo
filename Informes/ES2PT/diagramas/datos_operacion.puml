@startuml
skinparam dpi 180
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 17
skinparam backgroundColor white
hide circle
skinparam linetype ortho
entity "usuario" as usuario {
  * id : uuid <<PK>>
}
entity "reserva" as reserva {
  * id : uuid <<PK>>
}
entity "contrato" as contrato {
  * id : uuid <<PK>>
  * reserva_id : uuid <<FK>>
}
entity "firma_contrato" as firma_contrato {
  * contrato_id : uuid <<PK>>
  * usuario_id : uuid <<PK>>
}
entity "operacion_arriendo" as operacion_arriendo {
  * id : uuid <<PK>>
  * reserva_id : uuid <<FK>>
  * actor_id : uuid <<FK>>
}
entity "disputa" as disputa {
  * id : uuid <<PK>>
  * reserva_id : uuid <<FK>>
  * reclamante_id : uuid <<FK>>
  resolutor_id : uuid <<FK>>
}
reserva ||--o{ contrato
contrato ||--o{ firma_contrato
usuario ||--o{ firma_contrato
reserva ||--o{ operacion_arriendo
reserva ||--o{ disputa
@enduml
