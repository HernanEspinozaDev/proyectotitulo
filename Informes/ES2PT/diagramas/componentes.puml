@startuml
skinparam dpi 180
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 16
skinparam backgroundColor white
skinparam wrapWidth 160
top to bottom direction
skinparam componentStyle uml2
component "Interfaz web\nNext.js" as UI
package "Backend Go modular · un artefacto desplegable" {
component "API y autorización" as API
component "Identidad y perfiles\nM01–M03" as ID
component "Oferta y búsqueda\nM04–M05" as CAT
component "Reservas, pagos y contratos\nM06–M07" as RES
component "Operación y reputación\nM08–M09" as OP
component "Disputas y liquidación\nM10" as PAY
component "Administración y auditoría\nM11" as ADM
component "Adaptadores de proveedores" as AD
component "Conciliación y eventos\nresponsabilidad por diseñar" as EVT
}
database "PostgreSQL / PostGIS" as DB
component "Almacenamiento de archivos\nservicio por seleccionar" as FILE
component "Analítica / auditoría\nBigQuery propuesto;\ncontrol de inmutabilidad pendiente" as BQ
component "Proveedores externos\npago, firma, identidad y SII" as EXT
UI --> API : HTTPS / JSON
API --> ID
API --> CAT
API --> RES
API --> OP
API --> PAY
API --> ADM
ID --> AD
RES --> AD
PAY --> AD
AD --> EXT : contratos por verificar
EVT --> RES
EVT --> PAY
ID --> DB
CAT --> DB
RES --> DB
OP --> DB
PAY --> DB
ADM --> DB
OP --> FILE
RES --> FILE
ADM --> BQ
note bottom of DB
Interfaces de persistencia internas.
Las cajas del backend son módulos,
no microservicios desplegados por separado.
end note
@enduml
