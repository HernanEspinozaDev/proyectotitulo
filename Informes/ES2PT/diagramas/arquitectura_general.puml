@startuml
skinparam dpi 180
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 16
skinparam backgroundColor white
skinparam componentStyle uml2
top to bottom direction
actor "Arrendatario / arrendador" as USER
component "Cliente web futuro\nfuera del backend ES2" as WEB
package "Cloud Run · una aplicación Go" {
  component "API HTTPS / OpenAPI\nautorización" as API
  package "Módulos internos" {
    component "Identidad y oferta\nM01–M05" as INIT
    component "Reserva y contrato\nM06–M07" as CORE
    component "Operación y disputa\nM08–M10" as CLOSE
    component "Administración\nM11" as ADMIN
  }
  component "Workers internos\nreclamos durables" as WORKER
  component "Adaptadores\nservicios externos" as AD
}
database "Cloud SQL\nPostgreSQL / PostGIS" as DB
component "Cloud Storage\nprivado" as STORAGE
queue "Pub/Sub" as PUBSUB
database "BigQuery\nanalítica" as BQ
component "Pago / firma / identidad\nproveedores" as EXT

USER --> WEB : HTTPS
WEB --> API : HTTPS / JSON
API --> INIT
API --> CORE
API --> CLOSE
API --> ADMIN
INIT --> DB
CORE --> DB : reserva + ocupación + outbox
CLOSE --> DB
ADMIN --> DB
WORKER --> DB : leases / conciliación
WORKER --> PUBSUB : publicación Outbox
CORE --> AD
AD --> EXT : llamadas externas / sandbox en pruebas
API --> STORAGE : carga / lectura autorizadas
PUBSUB --> BQ : suscripción de eventos
@enduml
