@startuml
skinparam dpi 180
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 16
skinparam backgroundColor white
skinparam componentStyle uml2
top to bottom direction
actor "Cliente API futuro" as CLIENT
component "API Go\nHTTPS / OpenAPI" as API
package "Monolito modular Go · Cloud Run" {
  component "Casos de uso\ny autorización" as USECASE
  component "Reserva / pagos\npor interfaz" as DOMAIN
  component "Workers goroutine\nleases durables" as WORKER
}
database "Cloud SQL\nPostgreSQL / PostGIS" as DB
component "Cloud Storage\nprivado" as STORAGE
queue "Pub/Sub" as PUBSUB
database "BigQuery\nanalítica" as BQ
component "Proveedor externo\npruebas en sandbox" as PROVIDER

CLIENT --> API
API --> USECASE
USECASE --> DOMAIN
USECASE --> DB : transacción
DOMAIN --> PROVIDER : adaptador
DOMAIN --> DB : intento/evento proveedor
API --> STORAGE : objeto autorizado
WORKER --> DB : reclamo + checkpoint
WORKER --> PUBSUB : outbox
PUBSUB --> BQ : suscripción BigQuery
@enduml
