@startuml
skinparam dpi 180
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 17
skinparam backgroundColor white
hide circle
skinparam linetype ortho
entity "reserva" as reserva {
  * id : uuid <<PK>>
  * espacio_id : uuid <<FK>>
  * arrendatario_id : uuid <<FK>>
}
entity "pago" as pago {
  * id : uuid <<PK>>
  * reserva_id : uuid <<FK>>
}
entity "garantia" as garantia {
  * id : uuid <<PK>>
  * reserva_id : uuid <<FK>>
}
entity "evento_proveedor" as evento_proveedor {
  * id : uuid <<PK>>
  reserva_id : uuid <<FK>>
}
entity "liquidacion" as liquidacion {
  * id : uuid <<PK>>
  * reserva_id : uuid <<FK>>
}
reserva ||--o{ pago
reserva ||--o{ garantia
reserva |o--o{ evento_proveedor
reserva ||--o| liquidacion
@enduml
