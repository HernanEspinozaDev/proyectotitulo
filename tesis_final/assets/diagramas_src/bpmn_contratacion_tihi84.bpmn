<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="DefEspacigo" targetNamespace="urn:espacigo:tesis">
  <bpmn:process id="Contratacion" isExecutable="false">
    <bpmn:laneSet id="Responsabilidades">
      <bpmn:lane id="Partes" name="Partes del arriendo">
        <bpmn:flowNodeRef>Inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Acuerdo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Aceptacion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FirmaOpcional</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Firma</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UnirFirma</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Pagar</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Plataforma" name="Plataforma espaciGo">
        <bpmn:flowNodeRef>Bloqueo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Emision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Renta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GarantiaOpcional</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Garantia</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UnirGarantia</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Confirmar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Fin</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Inicio" name="Inicio" />
    <bpmn:userTask id="Acuerdo" name="Acordar horario y precio" />
    <bpmn:serviceTask id="Bloqueo" name="Verificar identidades y activar bloqueo" />
    <bpmn:serviceTask id="Emision" name="Emitir documento inmutable" />
    <bpmn:userTask id="Aceptacion" name="Aceptar la emisión" />
    <bpmn:exclusiveGateway id="FirmaOpcional" name="¿Modalidad con firma?" />
    <bpmn:userTask id="Firma" name="Acreditar aportes y firmar" />
    <bpmn:exclusiveGateway id="UnirFirma" name="" />
    <bpmn:userTask id="Pagar" name="Pagar la renta" />
    <bpmn:serviceTask id="Renta" name="Acreditar la renta" />
    <bpmn:exclusiveGateway id="GarantiaOpcional" name="¿Garantía exigible y habilitada?" />
    <bpmn:serviceTask id="Garantia" name="Acreditar garantía separada" />
    <bpmn:exclusiveGateway id="UnirGarantia" name="" />
    <bpmn:serviceTask id="Confirmar" name="Confirmar la reserva" />
    <bpmn:endEvent id="Fin" name="Fin" />
    <bpmn:sequenceFlow id="Flujo1" sourceRef="Inicio" targetRef="Acuerdo" name="" />
    <bpmn:sequenceFlow id="Flujo2" sourceRef="Acuerdo" targetRef="Bloqueo" name="" />
    <bpmn:sequenceFlow id="Flujo3" sourceRef="Bloqueo" targetRef="Emision" name="" />
    <bpmn:sequenceFlow id="Flujo4" sourceRef="Emision" targetRef="Aceptacion" name="" />
    <bpmn:sequenceFlow id="Flujo5" sourceRef="Aceptacion" targetRef="FirmaOpcional" name="" />
    <bpmn:sequenceFlow id="Flujo6" sourceRef="FirmaOpcional" targetRef="Firma" name="Sí" />
    <bpmn:sequenceFlow id="Flujo7" sourceRef="Firma" targetRef="UnirFirma" name="" />
    <bpmn:sequenceFlow id="Flujo8" sourceRef="UnirFirma" targetRef="Pagar" name="" />
    <bpmn:sequenceFlow id="Flujo9" sourceRef="Pagar" targetRef="Renta" name="" />
    <bpmn:sequenceFlow id="Flujo10" sourceRef="Renta" targetRef="GarantiaOpcional" name="" />
    <bpmn:sequenceFlow id="Flujo11" sourceRef="GarantiaOpcional" targetRef="Garantia" name="Sí" />
    <bpmn:sequenceFlow id="Flujo12" sourceRef="Garantia" targetRef="UnirGarantia" name="" />
    <bpmn:sequenceFlow id="Flujo13" sourceRef="UnirGarantia" targetRef="Confirmar" name="" />
    <bpmn:sequenceFlow id="Flujo14" sourceRef="Confirmar" targetRef="Fin" name="" />
    <bpmn:sequenceFlow id="Flujo15" sourceRef="FirmaOpcional" targetRef="UnirFirma" name="No" />
    <bpmn:sequenceFlow id="Flujo16" sourceRef="GarantiaOpcional" targetRef="UnirGarantia" name="No" />
  </bpmn:process>
