@startuml
!pragma layout smetana
skinparam dpi 200
skinparam shadowing false
skinparam state {
  BackgroundColor #EDF4FC
  BorderColor #345575
  FontColor #132A43
}
[*] --> Solicitada
Solicitada --> Acuerdo : acuerdo de horario y precio
Acuerdo --> Contratacion : identidades verificadas y bloqueo único
state "Contratación · bloqueo activo" as Contratacion {
  [*] --> Bloqueada
  Bloqueada --> Emitida : emitir documento inmutable
  Emitida --> Aceptada : aceptar ambas partes
  Aceptada --> Renta : sin firma
  Aceptada --> Firma : modalidad bilateral
  Firma --> Renta : aportes y ambas firmas
  Renta --> Cobros : renta acreditada
  Cobros --> Garantia : aplicable y habilitada
  state "Garantía por acreditar" as Garantia
  state "Renta acreditada" as Cobros
}
Contratacion --> Vencida : vence etapa / liberar bloqueo atómicamente
Vencida : pago tardío / conciliar sin reactivar
Cobros --> Confirmada : sin garantía exigible
Garantia --> Confirmada : garantía acreditada
Contratacion --> Cancelada : política aplicable / liberar y conciliar
Confirmada --> Cancelada : política aplicable / liberar y conciliar
Confirmada --> EnCurso : check-in con evidencia
state "En curso" as EnCurso
EnCurso --> Entregada : check-out con evidencia
Entregada --> Desocupada : confirma titular / liberar su intervalo
state "Desocupación confirmada" as Desocupada
EnCurso --> Disputa : reclamo admisible
Entregada --> Disputa : reclamo admisible
state "En disputa" as Disputa
Disputa : resolver y conciliar según política
@enduml
