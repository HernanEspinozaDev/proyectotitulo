@startuml
skinparam dpi 200
skinparam shadowing false
skinparam monochrome true
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 14
skinparam componentStyle rectangle
top to bottom direction
package "Presentación · Next.js" {
  component "Catálogo, cuenta y arriendo" as views
  component "BFF · autorización de solicitudes" as bff
  views --> bff
}
package "Aplicación · Go" {
  component "Entrada HTTP de la API\nSesión y autorización por recurso" as api
  component "Dominio\nEspacios · ocupación · reservas\nContratos · documentos" as domain
  component "Puertos de datos, objetos y servicios" as ports
  api --> domain
  domain --> ports
}
package "Adaptadores construidos" {
  database "PostgreSQL y PostGIS\nDocker en desarrollo" as db
  component "Persistencia de objetos y documentos S3\nAWS SDK para Go v2" as s3
  component "Correo SMTP\nServidor SMTP local de pruebas" as mail
}
bff --> api : HTTP por loopback
ports --> db
ports --> s3
ports --> mail
cloud "Entorno local compatible con AWS\nAlmacenamiento S3 por HTTPS" as emulator
s3 --> emulator
@enduml
