@startuml
!pragma layout smetana
skinparam dpi 170
title EspaciGo — Módulo M04: Gestión de Publicaciones
left to right direction
skinparam packageStyle rectangle

actor "Titular vigente" as ARR

rectangle "espaciGo — Plataforma de arriendo flexible de espacios" {
  package "M04 — Gestión de Publicaciones" {
    usecase "CU-15 Publicar un espacio" as CU15
    usecase "CU-16 Administrar galería" as CU16
    usecase "CU-17 Configurar Calendario de Disponibilidad" as CU17
    usecase "CU-18 Modificar o Dar de Baja Publicación" as CU18
  }
}

ARR -- CU15
ARR -- CU16
ARR -- CU17
ARR -- CU18
@enduml
