@startuml
!pragma layout smetana
skinparam shadowing false
skinparam dpi 170
actor "Arrendatario" as AR
actor "Titular" as TI
actor "SimpleFirma" as SF
rectangle "espaciGo — M07 Contratación" {
  usecase "CU-29 Emitir y aceptar contrato" as CU29
  usecase "CU-30 Firmar opcionalmente" as CU30
  usecase "CU-31 Consultar emisión" as CU31
  usecase "CU-32 Procesar vencimiento de firma" as CU32
}
AR -- CU29
TI -- CU29
AR -- CU31
TI -- CU31
SF -- CU30
CU30 ..> CU29 : <<extend>>\n[elección bilateral y aportes acreditados]
CU32 ..> CU30 : <<extend>>\n[etapa vencida]
@enduml
