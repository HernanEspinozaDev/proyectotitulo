left to right direction
skinparam dpi 170
actor "Arrendatario" as AR
actor "Titular" as TI
actor "Pasarela de pago" as PSP
actor "Proceso automático" as PA
rectangle "espaciGo — M06 Reservas y cobros" {
  usecase "CU-22 Solicitar intervalo" as CU22
  usecase "CU-23 Verificar disponibilidad" as CU23
  usecase "CU-26 Acordar horario y precio" as CU26
  usecase "CU-24 Acreditar renta" as CU24
  usecase "CU-25 Acreditar garantía" as CU25
  usecase "CU-27 Procesar vencimiento" as CU27
  usecase "CU-28 Conciliar pago tardío" as CU28
  usecase "CU-47 Consultar historial" as CU47
  usecase "CU-51 Cancelar reserva" as CU51
}
AR -- CU22
TI -- CU22
AR -- CU26
TI -- CU26
AR -- CU24
PSP -- CU24
PSP -- CU28
AR -- CU47
TI -- CU47
AR -- CU25
PA -- CU27
AR -- CU51
