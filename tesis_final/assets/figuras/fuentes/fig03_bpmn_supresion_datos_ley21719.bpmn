<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="fig03_bpmn_supresion_datos_ley21719" targetNamespace="https://espacigo.local/documentacion/es2">
  <bpmn:process id="Process_1" name="Solicitud de supresión de datos · espaciGo" isExecutable="false">
    <bpmn:startEvent id="inicio" name="Inicio">
      <bpmn:outgoing>Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="registro" name="Registrar solicitud&#10;del titular">
      <bpmn:incoming>Flow_0</bpmn:incoming>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:subProcess id="identidad" name="Verificar identidad&#10;y alcance de la solicitud">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="procedente" name="¿Solicitud&#10;procedente?">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="retencion" name="Evaluar obligaciones y&#10;retención aplicable">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="impedimentos" name="¿Hay impedimentos&#10;para la supresión?">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:subProcess id="anonimizar" name="Revocar sesiones y&#10;desidentificar datos">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:subProcess id="archivos" name="Purgar archivos y&#10;evidencias procedentes">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:task id="replay" name="Registrar ejecución&#10;y replay de bajas">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="respuesta" name="Notificar resultado&#10;al titular">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="fin" name="Fin">
      <bpmn:incoming>Flow_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="subsanacion" name="Comunicar requisitos&#10;de subsanación">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="fin_subsanar" name="Fin">
      <bpmn:incoming>Flow_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="limitacion" name="Comunicar decisión&#10;fundada y su alcance">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="fin_limitado" name="Fin">
      <bpmn:incoming>Flow_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0" sourceRef="inicio" targetRef="registro" name="" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="registro" targetRef="identidad" name="" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="identidad" targetRef="procedente" name="" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="procedente" targetRef="retencion" name="Sí" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="retencion" targetRef="impedimentos" name="" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="impedimentos" targetRef="anonimizar" name="No" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="anonimizar" targetRef="archivos" name="" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="archivos" targetRef="replay" name="" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="replay" targetRef="respuesta" name="" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="respuesta" targetRef="fin" name="" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="procedente" targetRef="subsanacion" name="No" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="subsanacion" targetRef="fin_subsanar" name="" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="impedimentos" targetRef="limitacion" name="Sí" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="limitacion" targetRef="fin_limitado" name="" />
  </bpmn:process>
