<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="fig01_bpmn_reserva_escrow_operacion" targetNamespace="https://espacigo.local/documentacion/es2">
  <bpmn:process id="Process_1" name="Reserva y operación de arriendo · espaciGo" isExecutable="false">
    <bpmn:startEvent id="inicio" name="Inicio">
      <bpmn:outgoing>Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="cotizacion" name="Recibir solicitud y&#10;validar cotización">
      <bpmn:incoming>Flow_0</bpmn:incoming>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="disponible" name="¿Intervalo&#10;disponible?">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="reserva" name="Crear reserva y&#10;retener intervalo">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:subProcess id="pago" name="Gestionar pago y&#10;vencimiento de retención">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="pagada" name="¿Pago confirmado&#10;dentro del plazo?">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="host" name="Recibir decisión&#10;del anfitrión">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="aceptada" name="¿Solicitud&#10;aprobada?">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:subProcess id="contrato" name="Formalizar contrato&#10;y firmas de las partes">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:subProcess id="operacion" name="Registrar check-in,&#10;check-out y recepción">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:subProcess id="liquidacion" name="Resolver liquidación&#10;o disputa, según evidencia">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:endEvent id="fin" name="Fin">
      <bpmn:incoming>Flow_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="conflicto" name="Notificar conflicto&#10;de disponibilidad">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="fin_conflicto" name="Fin">
      <bpmn:incoming>Flow_12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="vencimiento" name="Vencer solicitud y&#10;liberar intervalo">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="fin_vencida" name="Fin">
      <bpmn:incoming>Flow_14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="devolucion" name="Liberar intervalo y&#10;gestionar devolución">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="fin_rechazada" name="Fin">
      <bpmn:incoming>Flow_16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0" sourceRef="inicio" targetRef="cotizacion" name="" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="cotizacion" targetRef="disponible" name="" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="disponible" targetRef="reserva" name="Sí" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="reserva" targetRef="pago" name="" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="pago" targetRef="pagada" name="" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="pagada" targetRef="host" name="Sí" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="host" targetRef="aceptada" name="" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="aceptada" targetRef="contrato" name="Sí" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="contrato" targetRef="operacion" name="" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="operacion" targetRef="liquidacion" name="" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="liquidacion" targetRef="fin" name="" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="disponible" targetRef="conflicto" name="No" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="conflicto" targetRef="fin_conflicto" name="" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="pagada" targetRef="vencimiento" name="No" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="vencimiento" targetRef="fin_vencida" name="" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="aceptada" targetRef="devolucion" name="No" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="devolucion" targetRef="fin_rechazada" name="" />
  </bpmn:process>
