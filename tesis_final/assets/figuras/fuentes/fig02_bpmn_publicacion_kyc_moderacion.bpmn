<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="fig02_bpmn_publicacion_kyc_moderacion" targetNamespace="https://espacigo.local/documentacion/es2">
  <bpmn:process id="Process_1" name="Publicación y verificación · espaciGo" isExecutable="false">
    <bpmn:startEvent id="inicio" name="Inicio">
      <bpmn:outgoing>Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="solicitud" name="Recibir ficha del espacio&#10;y antecedentes">
      <bpmn:incoming>Flow_0</bpmn:incoming>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="borrador" name="Validar datos y&#10;crear borrador">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:subProcess id="medios" name="Procesar fotografías&#10;y variantes de medios">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:subProcess id="verificacion" name="Revisar antecedentes&#10;de identidad KYC/KYB">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="identidad" name="¿Verificación&#10;aprobada?">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="moderacion" name="Evaluar requisitos de&#10;publicación y moderación">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="aprobacion" name="¿Publicación&#10;autorizada?">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="publicar" name="Publicar espacio y&#10;actualizar catálogo">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="fin" name="Fin">
      <bpmn:incoming>Flow_8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="observacion_kyc" name="Comunicar&#10;observaciones KYC/KYB">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="fin_kyc" name="Fin">
      <bpmn:incoming>Flow_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="observacion_espacio" name="Comunicar ajustes&#10;y conservar borrador">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="fin_espacio" name="Fin">
      <bpmn:incoming>Flow_12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0" sourceRef="inicio" targetRef="solicitud" name="" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="solicitud" targetRef="borrador" name="" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="borrador" targetRef="medios" name="" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="medios" targetRef="verificacion" name="" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="verificacion" targetRef="identidad" name="" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="identidad" targetRef="moderacion" name="Sí" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="moderacion" targetRef="aprobacion" name="" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="aprobacion" targetRef="publicar" name="Sí" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="publicar" targetRef="fin" name="" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="identidad" targetRef="observacion_kyc" name="No" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="observacion_kyc" targetRef="fin_kyc" name="" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="aprobacion" targetRef="observacion_espacio" name="No" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="observacion_espacio" targetRef="fin_espacio" name="" />
  </bpmn:process>
